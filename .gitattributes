# 统一换行：容器内脚本必须是 LF，否则 shebang 会变成 "bad interpreter: /bin/sh^M"
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.mako text eol=lf
*.ini text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.txt text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.env.example text eol=lf
LICENSE text eol=lf
